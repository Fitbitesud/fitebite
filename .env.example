# رابط الموقع الرسمي (الدومين المخصص) — يُستخدم كأساس لروابط المشاركة SEO/OG
SITE_URL=https://fitbite-sudan.com/
# ── ربط Sanity (اختياري: الموقع يعمل بدونها ببيانات محلية) ──
# معرّف المشروع من https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
# اسم الداتاسيت
NEXT_PUBLIC_SANITY_DATASET=production
# إصدار API
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19
# تنبيه: NEXT_PUBLIC_ يظهر في ملفات المتصفح؛ لا تستخدم توكن الإدارة.
# يلزم توكن يسمح بعملية create على الداتاسيت؛ نوع comment هو document type وليس اسم صلاحية للتوكن.
NEXT_PUBLIC_SANITY_COMMENT_TOKEN=
